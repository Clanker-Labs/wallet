# ── Core ──────────────────────────────────────────────────────────────────
# SQLite file (created + migrated automatically). Default: ./data/wallet.db
# WALLET_DB_PATH=./data/wallet.db
WALLET_CURRENCY=EUR
WALLET_LOCALE=fr-FR
WALLET_TIMEZONE=Europe/Paris
# Public URL of the web app, used in Telegram messages (e.g. link to the CSV import page).
# WALLET_PUBLIC_URL=https://wallet.example.com

# ── Security ──────────────────────────────────────────────────────────────
# Protects the web UI with a password. Strongly recommended if the app is reachable from a network.
# WALLET_PASSWORD=
# Bearer token for programmatic access. Required for the remote MCP endpoint (/api/mcp)
# and the REST tools endpoint (/api/tools). Generate one: openssl rand -hex 32
# WALLET_API_TOKEN=

# ── Assistant ─────────────────────────────────────────────────────────────
# anthropic (Claude API, default) | claude-code (your local `claude` CLI) | codex (your local `codex` CLI) | none
WALLET_AGENT_PROVIDER=anthropic
# For the anthropic provider (or run `ant auth login`):
# ANTHROPIC_API_KEY=
# WALLET_AGENT_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
# WALLET_AGENT_EFFORT=medium
# Set to 1 to hide every write tool (record_balance, categorize…) from all agents and MCP clients.
# WALLET_AGENT_READONLY=0
# Optional overrides for the local CLI providers:
# WALLET_CLAUDE_BIN=claude
# WALLET_CLAUDE_MODEL=
# WALLET_CODEX_BIN=codex
# WALLET_CODEX_MODEL=

# ── Telegram reminders (npm run worker) ───────────────────────────────────
# Create a bot with @BotFather, paste its token, start the worker and send /start to get your chat id.
# TELEGRAM_BOT_TOKEN=
# Comma-separated allowlist of chat ids. Nobody else can use the bot.
# TELEGRAM_CHAT_ID=

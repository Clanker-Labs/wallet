# ── Core ──────────────────────────────────────────────────────────────────
# SQLite file (created + migrated automatically). Default: ./data/wallet.db
# WALLET_DB_PATH=./data/wallet.db
# Defaults for new users (each user can change their base currency in Settings).
# WALLET_CURRENCY=USD
# WALLET_LOCALE=en-US
# WALLET_TIMEZONE=America/New_York
# Public URL of the web app. Used for passkeys behind a proxy, magic links and links in Telegram messages.
# WALLET_PUBLIC_URL=https://wallet.example.com

# ── Accounts & passkeys ───────────────────────────────────────────────────
# Sign-in is passkey-only (Face ID / Touch ID / a phone via QR code). Passkeys need https, or http://localhost.
# The first person to open the app creates the owner account. Anyone else can create their own (fully separate)
# wallet at /signup. Set to 0 to close sign-ups once everyone's in (recommended if the app is reachable from the internet).
# WALLET_ALLOW_SIGNUP=1
# Passkey relying-party id (defaults to the host of WALLET_PUBLIC_URL / the request).
# WALLET_RP_ID=wallet.example.com
# Lost every passkey? `npm run auth:link` prints a one-time sign-in link (shell access required).

# ── Local API & MCP ───────────────────────────────────────────────────────
# Empty (default) = /api/* and /api/mcp need no token when called on localhost (and never from another
# website in your browser). Such requests act as the owner (or WALLET_USER_ID).
# Set a token as soon as the port is reachable from a network: openssl rand -hex 32
# WALLET_API_TOKEN=
# Extra hostnames allowed for token-less access, e.g. a LAN name (comma-separated). Use with care.
# WALLET_ALLOWED_HOSTS=
# Which user the stdio MCP server, token-only API calls and the CLI tools act as (default: the owner).
# WALLET_USER_ID=

# ── Assistant ─────────────────────────────────────────────────────────────
# anthropic (Claude API, default) | claude-code (your local `claude` CLI) | codex (your local `codex` CLI) | none
WALLET_AGENT_PROVIDER=anthropic
# For the anthropic provider (or run `ant auth login`):
# ANTHROPIC_API_KEY=
# WALLET_AGENT_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
# WALLET_AGENT_EFFORT=medium
# Set to 1 to hide every write tool (record_balance, import…) from all agents and MCP clients.
# WALLET_AGENT_READONLY=0
# Optional overrides for the local CLI providers:
# WALLET_CLAUDE_BIN=claude
# WALLET_CLAUDE_MODEL=
# WALLET_CODEX_BIN=codex
# WALLET_CODEX_MODEL=

# ── Telegram reminders (npm run worker) ───────────────────────────────────
# Create a bot with @BotFather and paste its token. Each user links their chat from Settings → Telegram.
# TELEGRAM_BOT_TOKEN=
# Optional: the bot's @username for one-tap "Open in Telegram" links (otherwise looked up with the token).
# TELEGRAM_BOT_USERNAME=
# Optional legacy allowlist: these chat ids act as the owner without linking.
# TELEGRAM_CHAT_ID=
